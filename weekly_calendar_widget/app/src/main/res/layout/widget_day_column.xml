<?xml version="1.0" encoding="utf-8"?>
<!-- Single day column: weight=1, fits 7 equal columns in horizontal parent -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dayColumnRoot"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical">

    <!-- Day header area -->
    <LinearLayout
        android:id="@+id/dayHeaderArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/day_header_background"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:layout_marginEnd="2dp">

        <!-- Day abbreviation: 월 화 수 목 금 토 일 -->
        <TextView
            android:id="@+id/tvDayOfWeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#B0BEC5"
            android:gravity="center" />

        <!-- Date number: 4, 5, ... 10 -->
        <TextView
            android:id="@+id/tvDayNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#607080"
            android:gravity="center" />

        <!-- "오늘" badge: visible only for today -->
        <TextView
            android:id="@+id/tvTodayBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/today_label"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#0D1117"
            android:background="@drawable/today_badge_background"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Events list (items added via addView) -->
    <LinearLayout
        android:id="@+id/eventsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:layout_marginEnd="2dp" />

</LinearLayout>
